# ── Build output ──────────────────────────────────────────────────────────────
/target/
/target-*/
/plugins/target/
/dist/
/corpus/
/log/

# ── Logs and profiles ────────────────────────────────────────────────────────
*.log
*.profraw

# ── Editors and OS ───────────────────────────────────────────────────────────
.DS_Store
*~
.idea/
.vscode/
.cache/

# ── Local reference copies, never committed ──────────────────────────────────
# The immediate-mode front-end stays on disk as the reference the port is checked against,
# and the two legacy app shells are not part of this repository.
/crates/ui-egui/
/apps/figcraft/
/apps/figcraft-web/

# ── Scratch, plans and agent files ───────────────────────────────────────────
/.tmp/
plan/
plans/
.workbuddy-ai/
.workbuddy/memory/
/_base_lib.rs
/_lib_render_cut_backup.rs
/_render_base.rs

# ── Development screenshots and source excerpts ──────────────────────────────
# Regenerated on demand; the excerpts are read from crates/ui-egui.
/crates/ui-gpui/*.png
/shot_*.png
/crop_*.png
/crates/ui-gpui/src/panels/right/reference/
